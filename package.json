    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
